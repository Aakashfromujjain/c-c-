#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    string S;
    char C;
    
    // Read the string and the character
    if (cin >> S >> C) {
        // Use the STL count function to find the occurrences of C in S
        int count_occurrences = count(S.begin(), S.end(), C);
        cout << count_occurrences << "\n";
    }

    return 0;
}
